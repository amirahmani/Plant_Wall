{
    // The default build target is the STM32 (.cargo/config.toml), which has no
    // `test` crate. Without these, rust-analyzer builds #[test] code for the chip
    // and shows "can't find crate for `test`" on every test.

    // Background check: don't compile test code for the STM32.
    // (Mistakes inside tests then show up when you run `cargo test-logic`.)
    "rust-analyzer.check.allTargets": false,

    // ▶ Run Test / Debug buttons: run on this PC instead of the STM32.
    // Flash the firmware from the terminal with `cargo run --release`, not the ▶ Run button above main().
    "rust-analyzer.runnables.extraArgs": ["--target", "x86_64-unknown-linux-gnu"]
}
