   LANGNAME "Button hold time to open the menu"
   EINHEIT_W "ms"
   WERT 1000
END

FESTWERT P_SYSCHK_LED_MS
   LANGNAME "Sys check: LED on time"
   EINHEIT_W "ms"
   WERT 1000
END

FESTWERT P_SYSCHK_STEP_MS
